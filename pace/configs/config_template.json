{
  "distributed": true,
  "datasets": {
    "model": {
      "name": "graphcast",
      "path": "${GRAPHCAST_PATH}"
    },
    "reference": {
      "name": "era5",
      "path": "${ERA5_PATH}"
    }
  },
  "outputs_dir": "${OUTPUTS_DIR_PATH}",
  "metrics": {
    "geostrophic_balance": ["geostrophic_wind_ratio"],
    "hydrostatic_balance": ["all"],
    "correlation": ["all"],
    "correlation_map": ["all"],
    "potential_vorticity": ["all"],
    "humidity_temperature": ["all"]
  },
  "spatial": {
    "pressure_levels": 37,
    "lat_range": [45, 50],
    "lon_range": [45, 50]
  },
  "time": {
    "start": "20210401",
    "end": "20210404",
    "num_lead_times": 5, 
    "stride_hours": 6,
    "sample_percent": 10,
    "custom_times": {"enabled": false, "times": ["20210402_12", "20210403_00"]}
  },
  "visualization": {
    "plots_dir": "${PLOTS_DIR_PATH}",
    "histogram": false,
    "vertical_profile": false,
    "summary_stats": ["mean", "stdev", "min", "max"],
    "spatial_slice": {"enabled": false, "variable": "geostrophic_wind_ratio", "level": 500, "samples": 3}
  }
}
