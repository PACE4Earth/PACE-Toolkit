{
  "datasets": {
    "model": {
      "name": "graphcast",
      "path": "${GRAPHCAST_EXTENDED_DATA_PATH}"
    }
  },
  "metrics": [
    "correlation_map"
  ],
  "spatial": {
    "pressure_levels": 3,
    "lat_range": [35, 47],
    "lon_range": [171, 187]
  },
  "time": {
    "start": "20210401",
    "end": "20210630",
    "stride_hours": 6,
    "lead_times": 40
  },
  "visualization": {
    "n_fullfield_samples": 8,
    "summary_stats": ["mean", "stdev", "min", "max"],
    "enabled": true,
    "plot_metrics": ["geostrophic_balance"],
    "output_dir": "results/plots"
  }
}