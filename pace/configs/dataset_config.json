{
  "datasets": {
    "model": {
      "name": "graphcast",
      "path": "${GRAPHCAST_EXTENDED_DATA_PATH}"
    },
    "reference": {
      "name": "era5",
      "path": "${ERA5_DATA_PATH}"
    }
  },
  "outputs_dir": "${OUTPUTS_DIR_PATH}",
   "metrics": {
    "geostrophic_balance": ["geostrophic_wind_ratio"],
    "hydrostatic_balance": ["all"],
    "correlation": ["all"],
    "correlation_map": ["all"]
  },
  "spatial": {
    "pressure_levels": 3,
    "lat_range": [49, 50],
    "lon_range": [49, 50]
  },
  "time": {
    "start": "20210401",
    "end": "20210412",
    "stride_hours": 6,
    "lead_times": 40, 
    "sample_percent": 10
  },
  "visualization": {
    "enabled": true,
    "summary_stats": ["mean", "stdev", "min", "max"],
    "plot_metrics": ["geostrophic_balance"],
    "plots_dir": "plots"
  }
}