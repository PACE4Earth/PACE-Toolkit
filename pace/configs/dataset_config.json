{
  "datasets": {
    "model": {
      "name": "graphcast",
      "path": "${GRAPHCAST_EXTENDED_DATA_PATH}"
    },
    "reference": {
      "name": "era5",
      "path": "${ERA5_DATA_PATH}"
    }
  },
  "metrics": [
    "geostrophic_balance",
    "hydrostatic_balance",
    "correlation",
    "correlation_map"
  ],
  "spatial": {
    "pressure_levels": 3,
    "lat_range": [49, 50],
    "lon_range": [49, 50]
  },
  "time": {
    "start": "20210401",
    "end": "20210412",
    "stride_hours": 6,
    "lead_times": 40, 
    "sample_percent": 10
  },
  "visualization": {
    "summary_stats": ["mean", "stdev", "min", "max"],
    "enabled": true,
    "plot_metrics": ["geostrophic_balance"],
    "output_dir": "results/plots"
  }
}