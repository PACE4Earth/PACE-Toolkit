{
  "distributed": true,
  "datasets": {
    "model": {
      "name": "graphcast",
      "path": "${GRAPHCAST_PATH}"
    },
    "reference": {
      "name": "era5",
      "path": "${ERA5_PATH}"
    }
  },
  "outputs_dir": "${OUTPUTS_DIR_PATH}",
  "metrics": {
    "energy_conservation": ["all"],
    "mass_conservation": ["all"]
  },
  "spatial": {
    "pressure_levels": 37,
    "lat_range": [30, 80],
    "lon_range": [0, 180]
  },
  "time": {
    "start": "20210601",
    "end": "20210610",
    "num_lead_times": 40, 
    "stride_hours": 6,
    "sample_percent": 100,
    "custom_times": {"enabled": false, "times": ["20210605_12"]}
  },
  "visualization": {
    "plots_dir": null,
    "histogram": false,
    "vertical_profile": false,
    "summary_stats": ["mean", "stdev", "min", "max"],
    "spatial_slice": {"enabled": false, "variable": "geostrophic_wind_ratio", "level": 500, "samples": 2},
    "spatial_average": false,
    "time_series": true
  }
}